# SHARED ENVIROMENT VARIABLES
# HERE YOU CAN ADD ALL THE **PUBLIC** ENVIRONMENT VARIABLES THAT ARE SHARED ACROSS ALL THE ENVIROMENTS
# PLEASE DO NOT ADD ANY CONFIDENTIAL KEYS OR SENSITIVE INFORMATION HERE
# ONLY CONFIGURATION, PATH, FEATURE FLAGS, ETC.
# TO OVERRIDE THESE VARIABLES IN A SPECIFIC ENVIRONMENT, PLEASE ADD THEM TO THE SPECIFIC ENVIRONMENT FILE (e.g. .env.development, .env.production)

# SITE
NEXT_PUBLIC_SITE_URL=https://un-claude.com
NEXT_PUBLIC_PRODUCT_NAME=Un-Claude
NEXT_PUBLIC_SITE_TITLE="Un-Claude · AI Watermark Remover"
NEXT_PUBLIC_SITE_DESCRIPTION="Scan text and files free for hidden AI watermarks: invisible characters, C2PA metadata and the statistical mark in the words themselves. Sanitise them in seconds."
NEXT_PUBLIC_DEFAULT_THEME_MODE=light
NEXT_PUBLIC_THEME_COLOR="#ffffff"
NEXT_PUBLIC_THEME_COLOR_DARK="#0a0a0a"

# AUTH
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false
# Cloudflare Turnstile, invisible widget. PUBLIC by design and safe to commit:
# the site key identifies the widget to Cloudflare, the secret key does the
# verifying and lives only in the Supabase dashboard. Hostnames registered on
# the widget: un-claude.com and localhost. 20 August 2026.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=0x4AAAAAAEXKpQRbLAfG3DbU

# LOCALES PATH
NEXT_PUBLIC_LOCALES_PATH=apps/web/i18n/messages

# ANALYTICS
# PostHog project key. The real value lives on Vercel; blank here means analytics
# is off, which is the state every local machine runs in. The key is write only
# and cannot read anything back, which is why it is safe in the browser.
#
# BOTH NAMES MUST ALSO APPEAR IN turbo.json globalEnv. Turborepo 2 filters the
# build environment in strict mode, so an undeclared variable is stripped before
# Next ever sees it. A NEXT_PUBLIC_ value is inlined at BUILD time, so the result
# is a deployment that silently has no analytics while Vercel shows the setting
# present and correct.
#
# Configured cookieless in components/analytics-provider.tsx. If that ever
# changes, the privacy and cookie policies change with it and the site needs a
# consent banner.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# FEATURE FLAGS
# Dark mode retired, 20 August 2026. Jon: "get rid of dark version... we
# don't need dark version anymore." Site is forced light in root-providers.tsx;
# this hides the toggle everywhere it's read (header, account dropdown).
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=false
NEXT_PUBLIC_LANGUAGE_PRIORITY=application
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_DELETION=true