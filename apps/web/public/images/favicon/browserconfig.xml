<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows tile, 04 entry 99 (Tile) and entry 100.

  Two things here were starter-template leftovers rather than choices: the
  logo path pointed at /mstile-150x150.png, which has never existed at the
  site root (the file lives under /images/favicon/), and TileColor was
  #00a300, a green belonging to no part of this product. The colour is now
  the accent the tile itself is painted in, so the plate behind a bleed
  image matches it instead of framing it in green.
-->
<browserconfig>
    <msapplication>
        <tile>
            <square150x150logo src="/images/favicon/mstile-150x150.png"/>
            <TileColor>#c45e3d</TileColor>
        </tile>
    </msapplication>
</browserconfig>
