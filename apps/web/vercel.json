{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/tool/clean/route.ts": {
      "supportsCancellation": true
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.un-claude.com" }],
      "destination": "https://un-claude.com/$1",
      "permanent": true
    },
    {
      "source": "/dev/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
