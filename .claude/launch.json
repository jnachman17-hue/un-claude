{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 3000
    },
    {
      "name": "web-b",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev", "--port", "3001"],
      "port": 3001
    },
    {
      "name": "web-c",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev", "--port", "3002"],
      "port": 3002
    },
    {
      "name": "web-d",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev", "--port", "3003"],
      "port": 3003
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "start"],
      "env": { "PORT": "3100" },
      "port": 3100
    },
    {
      "name": "engine",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["server.py", "--port", "8765"],
      "cwd": "apps/web/engine",
      "env": { "UC_PRODUCT_POLICY": "1" },
      "port": 8765
    }
  ]
}
