{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "un-claude-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "un-claude-web-t4",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "exec",
        "next",
        "dev",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "un-claude-web-t4-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "exec",
        "next",
        "start",
        "--port",
        "3100"
      ],
      "port": 3100
    }
  ]
}
